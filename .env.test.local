# Copy this file to .env.local and fill in real values (.env* is gitignored — never commit real values)
# In production: non-secret values go through helm configuration.yaml, DB_PASSWORD goes through Vault (ask webops for the path)

DB_READ_HOST=
DB_READ_PORT=3306

# If webops provides a separate write host, fill it in — otherwise the backend falls back to the read host
DB_WRITE_HOST=
DB_WRITE_PORT=

DB_NAME=ssa_flowmate

DB_USER=
DB_PASSWORD=

# Backend's own port (defaults to 80 to match the container on webops)
PORT=8080

# Google OAuth — reuse the SAME app Supabase Auth already uses (Supabase Dashboard ->
# Authentication -> Providers -> Google for the Client ID; the Secret is not shown again
# there, get it from Google Cloud Console -> APIs & Services -> Credentials instead).
# Remember to add the webops domain's callback URL to "Authorized redirect URIs" there too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:8899/auth/google/callback

# Used to sign JWTs issued after login — any long random string, generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
